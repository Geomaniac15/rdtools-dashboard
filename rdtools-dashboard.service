[Unit]
Description=RD Tools dashboard (rdtools.q-id landing page)
After=network-online.target
Wants=network-online.target

[Service]
User=qb
Group=www-data
WorkingDirectory=/home/qb/rdtools-dashboard
Environment="PATH=/home/qb/rdtools-dashboard/venv/bin"
ExecStart=/home/qb/rdtools-dashboard/venv/bin/gunicorn --workers 2 --bind 127.0.0.1:8001 app:app
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
